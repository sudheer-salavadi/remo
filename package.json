{
  "name": "remo",
  "version": "1.0.0",
  "description": "Code-driven launch, promo and social videos for your apps, built on Remotion",
  "repository": {},
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/animation-utils": "^4.0.536",
    "@remotion/captions": "^4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/effects": "^4.0.536",
    "@remotion/fonts": "^4.0.536",
    "@remotion/google-fonts": "^4.0.536",
    "@remotion/layout-utils": "^4.0.536",
    "@remotion/lottie": "^4.0.536",
    "@remotion/media": "^4.0.536",
    "@remotion/media-utils": "^4.0.536",
    "@remotion/motion-blur": "^4.0.536",
    "@remotion/noise": "^4.0.536",
    "@remotion/paths": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@remotion/sfx": "^4.0.536",
    "@remotion/shapes": "^4.0.536",
    "@remotion/tailwind-v4": "4.0.536",
    "@remotion/three": "^4.0.536",
    "@remotion/transitions": "^4.0.536",
    "@remotion/zod-types": "^4.0.536",
    "@types/three": "^0.186.0",
    "lottie-web": "^5.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536",
    "tailwindcss": "4.0.0",
    "three": "^0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc && node scripts/check-motion.mjs",
    "render": "remotion render",
    "render:hq": "remotion render --codec=h264 --crf=12 --x264-preset=slow",
    "render:prores": "remotion render --codec=prores --prores-profile=hq",
    "render:alpha": "remotion render --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "render:4k": "remotion render --codec=h264 --crf=12 --x264-preset=slow --scale=2",
    "still": "remotion still",
    "render:final": "python3 scripts/render-clean.py"
  },
  "allowScripts": {
    "esbuild": false
  },
  "sideEffects": [
    "*.css"
  ]
}
